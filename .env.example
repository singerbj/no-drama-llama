# PostHog is configured at build time (baked in with option_env!, like NDL_UPDATE_PUBKEY).
# Export these in the shell that runs `cargo build`; release builds get them from the
# POSTHOG_PROJECT_TOKEN / POSTHOG_HOST repository variables. Unset means no analytics.
POSTHOG_PROJECT_TOKEN=your_posthog_project_token
POSTHOG_HOST=https://us.i.posthog.com
