{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/marketing/**",
              "components/models/**",
              "ui_kits/settings-window/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Google Sans Code|Unbounded))/i]",
        "message": "Font not provided by the design system. Available: Google Sans Code, Unbounded."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|action|style|children|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: tone, action, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|active|disabled|type|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, active, disabled, type, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|primary|danger|tab)$/]",
        "message": "<Button> variant must be one of 'default' | 'primary' | 'danger' | 'tab'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CatalogRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|note|fit|recommended|state|onAction|last|key|ref|className|style|children)$/]",
        "message": "<CatalogRow> doesn't accept that prop. Declared props: label, note, fit, recommended, state, onAction, last."
      },
      {
        "selector": "JSXOpeningElement[name.name='CatalogRow'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:gpu|gpuAndRam|tooBig)$/]",
        "message": "<CatalogRow> fit must be one of 'gpu' | 'gpuAndRam' | 'tooBig'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CatalogRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:download|installed|downloading|unavailable)$/]",
        "message": "<CatalogRow> state must be one of 'download' | 'installed' | 'downloading' | 'unavailable'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:running|loading|paused|off|error|game)$/]",
        "message": "<Chip> tone must be one of 'running' | 'loading' | 'paused' | 'off' | 'error' | 'game'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeWindow'] > JSXAttribute > JSXIdentifier[name!=/^(?:filename|children|style|key|ref|className|style|children)$/]",
        "message": "<CodeWindow> doesn't accept that prop. Declared props: filename, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:caption|columns|rows|style|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: caption, columns, rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='DownloadProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|done|total|onCancel|note|style|key|ref|className|style|children)$/]",
        "message": "<DownloadProgress> doesn't accept that prop. Declared props: label, done, total, onCancel, note, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactList'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<FactList> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FaqItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:question|defaultOpen|children|style|key|ref|className|style|children)$/]",
        "message": "<FaqItem> doesn't accept that prop. Declared props: question, defaultOpen, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|tone|children|style|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: icon, title, tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:running|loading|paused|off|error|game)$/]",
        "message": "<FeatureCard> tone must be one of 'running' | 'loading' | 'paused' | 'off' | 'error' | 'game'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Fieldset'] > JSXAttribute > JSXIdentifier[name!=/^(?:legend|disabled|style|children|key|ref|className|style|children)$/]",
        "message": "<Fieldset> doesn't accept that prop. Declared props: legend, disabled, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModelPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:models|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<ModelPicker> doesn't accept that prop. Declared props: models, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NumberInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|min|max|step|width|invalid|style|key|ref|className|style|children)$/]",
        "message": "<NumberInput> doesn't accept that prop. Declared props: value, onChange, min, max, step, width, invalid, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|icon|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<PillButton> doesn't accept that prop. Declared props: variant, size, href, icon, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost)$/]",
        "message": "<PillButton> variant must be one of 'primary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PillButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<PillButton> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SaveBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|onRevert|onSave|saveDisabled|floating|style|key|ref|className|style|children)$/]",
        "message": "<SaveBar> doesn't accept that prop. Declared props: message, onRevert, onSave, saveDisabled, floating, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|options|minWidth|invalid|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: value, onChange, options, minWidth, invalid, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SettingRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|stacked|htmlFor|last|children|key|ref|className|style|children)$/]",
        "message": "<SettingRow> doesn't accept that prop. Declared props: label, hint, stacked, htmlFor, last, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SideNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onSelect|style|key|ref|className|style|children)$/]",
        "message": "<SideNav> doesn't accept that prop. Declared props: items, active, onSelect, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StateTimeline'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|style|key|ref|className|style|children)$/]",
        "message": "<StateTimeline> doesn't accept that prop. Declared props: steps, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|size|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<StatusDot> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|subtitle|actions|style|key|ref|className|style|children)$/]",
        "message": "<StatusHeader> doesn't accept that prop. Declared props: tone, title, subtitle, actions, style."
