        "selector": "JSXOpeningElement[name.name='TextArea'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|rows|invalid|style|key|ref|className|style|children)$/]",
        "message": "<TextArea> doesn't accept that prop. Declared props: value, onChange, rows, invalid, style."
