        "selector": "JSXOpeningElement[name.name='StatusPopup'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|subtitle|animated|style|key|ref|className|style|children)$/]",
        "message": "<StatusPopup> doesn't accept that prop. Declared props: tone, title, subtitle, animated, style."
