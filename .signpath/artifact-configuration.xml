<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the release workflow's `exe` artifact (see docs/releasing.md).
  SignPath keeps its own copy: paste this into the project's artifact configuration on signpath.io
  whenever it changes. GitHub zips the artifact, so the root is a zip file.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <!-- The release version without the leading v, passed by the workflow. -->
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="no-drama-llama.exe" product-name="No Drama Llama" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
